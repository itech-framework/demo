<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.itech.framework.javafxapp.demo.controllers.tasks.CalendarViewController">
   <children>
       <BorderPane layoutX="300.0" layoutY="225.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
           <top>
               <HBox prefHeight="50.0" spacing="10.0" BorderPane.alignment="CENTER">
                   <padding>
                       <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                   </padding>
                  <children>
                      <Button mnemonicParsing="false" text="Button" />
                      <Button mnemonicParsing="false" text="Button" />
                      <Button mnemonicParsing="false" text="Button" />
                  </children>
               </HBox>
           </top>
           <center>
               <VBox BorderPane.alignment="CENTER">
                  <children>
                      <HBox VBox.vgrow="ALWAYS">
                         <children>
                             <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <TableView fx:id="tableView" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn prefWidth="142.0" text="Times" />
                                            <TableColumn prefWidth="142.0" text="Sunday" />
                                            <TableColumn minWidth="8.0" prefWidth="102.0" text="Monday" />
                                            <TableColumn minWidth="8.0" prefWidth="102.0" text="Tuesday" />
                                            <TableColumn prefWidth="142.0" text="Wednesday" />
                                            <TableColumn minWidth="8.0" prefWidth="102.0" text="Thursday" />
                                            <TableColumn prefWidth="142.0" text="Friday" />
                                            <TableColumn minWidth="8.0" prefWidth="102.0" text="Saturday" />
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                    </TableView>
                                </children>
                             </VBox>
                         </children>
                      </HBox>
                  </children>
               </VBox>
           </center>
       </BorderPane>
   </children>
</AnchorPane>
