<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.collections.FXCollections?>

<AnchorPane prefHeight="400.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/11.0.14-internal"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.itech.framework.javafxapp.demo.controllers.tasks.TaskViewController">

   <BorderPane layoutX="67.0" layoutY="62.0"
               AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="0.0">

      <top>
         <VBox>
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="10.0"
                  BorderPane.alignment="CENTER">
               <Button mnemonicParsing="false" onAction="#handleBackBtnClicked" text="Back" />
               <Button mnemonicParsing="false" text="Create" />
               <TextField minWidth="200" promptText="Search tasks..." />
               <Button mnemonicParsing="false" text="Search" />
            </HBox>
            <HBox fx:id="tagButtonContainer" prefHeight="30.0" spacing="5.0">
               <Button onAction="#handleTagChanged" styleClass="tag-btn, list, active"
                       mnemonicParsing="false" text="List" />
               <Button onAction="#handleTagChanged" styleClass="tag-btn, deadline"
                       mnemonicParsing="false" text="Deadline" />
               <Button onAction="#handleTagChanged" styleClass="tag-btn, teams"
                       mnemonicParsing="false" text="Teams" />
               <Button onAction="#handleTagChanged" styleClass="tag-btn, setting"
                       mnemonicParsing="false" text="Setting" />
            </HBox>
         </VBox>
      </top>

      <padding>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
      </padding>

      <center>
         <StackPane BorderPane.alignment="CENTER">
            <BorderPane.margin>
               <Insets top="10.0" />
            </BorderPane.margin>

            <!-- Original Content Container -->
            <AnchorPane fx:id="contentContainer" prefHeight="200.0" prefWidth="200.0" />

            <!-- Loading Overlay (centered in contentContainer) -->
            <StackPane fx:id="loadingOverlay" visible="false">
               <VBox alignment="CENTER" spacing="10">
                  <ProgressIndicator fx:id="loadingSpinner"
                                     prefWidth="40" prefHeight="40"/>
                  <Label text="Loading..." />
               </VBox>
            </StackPane>
         </StackPane>
      </center>
   </BorderPane>
</AnchorPane>