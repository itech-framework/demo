<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.layout.*?>


<?import org.itech.framework.javafxapp.demo.common.components.TagControl?>
<AnchorPane prefHeight="400.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.itech.framework.javafxapp.demo.controllers.tasks.DeadlineViewController"
            styleClass="content-body, primary-background" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
    <HBox layoutX="178.0" layoutY="135.0" spacing="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets top="10.0" left="10.0" right="10.0" bottom="10.0" />
        </padding>
        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <TagControl text="Overdue"
                        styleClass="overdue"
                        cornerRadius="10"/>
        </VBox>
        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <TagControl text="Due Today"
                        styleClass="today"
                        cornerRadius="10"/>
        </VBox>
        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <TagControl text="Due This Week"
                        styleClass="this-week"
                        cornerRadius="10"/>
        </VBox>
        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
            <TagControl text="Due This Month"
                        styleClass="this-month"
                        cornerRadius="10"/>
        </VBox>
    </HBox>
</AnchorPane>
