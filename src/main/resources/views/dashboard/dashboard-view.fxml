<?xml version="1.0" encoding="UTF-8" ?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/11.0.14-internal"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.itech.framework.javafxapp.demo.controllers.dashboard.DashboardController">
    <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                AnchorPane.topAnchor="0.0">
        <top>
            <HBox alignment="CENTER" prefHeight="100.0" BorderPane.alignment="CENTER">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;"
                       text="..." fx:id="title"/>
            </HBox>
        </top>
        <center>
            <VBox BorderPane.alignment="CENTER">
                <HBox alignment="CENTER" spacing="5.0">
                    <Button fx:id="darkModeBtn" mnemonicParsing="false" text="Dark Mode" />
                    <TextField fx:id="searchInput" promptText="Search tasks..." style="-fx-pref-width: 300px;"/>
                    <Button mnemonicParsing="false" style="-fx-pref-width: 80px;" text="Search"/>
                </HBox>
                <HBox alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="30"/>
                    </padding>
                    <VBox alignment="TOP_CENTER" spacing="20.0" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>

                        <HBox spacing="20.0" alignment="CENTER">
                            <AnchorPane styleClass="card, today"
                                        minWidth="80" maxWidth="80"
                                        minHeight="80" maxHeight="80"
                                        prefWidth="80" prefHeight="80"
                                        onMouseClicked="#handleCardClick">
                                <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                                      AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <ImageView fitHeight="30" fitWidth="30" pickOnBounds="true">
                                        <Image url="@/static/images/task-icon.png"/>
                                    </ImageView>
                                </HBox>
                                <Label styleClass="menu-label" text="Tasks"
                                       AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"/>
                            </AnchorPane>

                            <AnchorPane styleClass="card, fav"
                                        minWidth="80" maxWidth="80"
                                        minHeight="80" maxHeight="80"
                                        prefWidth="80" prefHeight="80"
                                        onMouseClicked="#handleCardClick">
                                <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                                      AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <ImageView fitHeight="30" fitWidth="30" pickOnBounds="true">
                                        <Image url="@/static/images/star-icon.png"/>
                                    </ImageView>
                                </HBox>
                                <Label styleClass="menu-label" text="Favourite"
                                       AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"/>
                            </AnchorPane>

                            <AnchorPane styleClass="card, done"
                                        minWidth="80" maxWidth="80"
                                        minHeight="80" maxHeight="80"
                                        prefWidth="80" prefHeight="80"
                                        onMouseClicked="#handleCardClick">
                                <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                                      AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <ImageView fitHeight="30" fitWidth="30" pickOnBounds="true">
                                        <Image url="@/static/images/check-icon.png"/>
                                    </ImageView>
                                </HBox>
                                <Label styleClass="menu-label" text="Completed"
                                       AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"/>
                            </AnchorPane>

                            <AnchorPane styleClass="card, note"
                                        minWidth="80" maxWidth="80"
                                        minHeight="80" maxHeight="80"
                                        prefWidth="80" prefHeight="80"
                                        onMouseClicked="#handleCardClick">
                                <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                                      AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <ImageView fitHeight="30" fitWidth="30" pickOnBounds="true">
                                        <Image url="@/static/images/note-icon.png"/>
                                    </ImageView>
                                </HBox>
                                <Label styleClass="menu-label" text="Take Notes"
                                       AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"/>
                            </AnchorPane>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </center>
    </BorderPane>
</AnchorPane>
