<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.collections.FXCollections?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.itech.framework.javafxapp.demo.controllers.tasks.ListViewController"
            styleClass="content-body, primary-background" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
    <right>
        <ScrollPane hbarPolicy="NEVER" pannable="true"
                    prefViewportHeight="600"
                    prefViewportWidth="350"
                    cache="true"
                    cacheHint="SPEED" fitToHeight="true" fitToWidth="true">
            <VBox prefWidth="350" spacing="10" style="-fx-padding: 10;" styleClass="sidebar">
                <VBox styleClass="card-b">
                    <Label text="Create New Task" styleClass="card-b-title"/>
                    <VBox spacing="12" style="-fx-padding: 0 0 0 5;">
                        <TextField fx:id="taskTitleText" promptText="Task Title" styleClass="modern-input"/>
                        <TextArea fx:id="description" promptText="Description" styleClass="modern-textarea"
                                  prefRowCount="2"/>
                        <HBox spacing="10">
                            <DatePicker fx:id="startDateText" promptText="Start Date" styleClass="modern-datepicker"/>
                            <DatePicker fx:id="dueDateText" promptText="Due Date" styleClass="modern-datepicker"/>
                        </HBox>
                        <HBox spacing="10" >
                            <ComboBox HBox.hgrow="ALWAYS" fx:id="priorityComboBox" promptText="Priority" styleClass="modern-combo"/>
                            <ComboBox HBox.hgrow="ALWAYS" fx:id="statusComboBox" promptText="Status" styleClass="modern-combo"/>
                        </HBox>
                        <TextField fx:id="progressInput" promptText="Progress (%)" styleClass="modern-input">
                            <opaqueInsets>
                                <Insets/>
                            </opaqueInsets>
                        </TextField>

                        <HBox spacing="10">
                            <Button fx:id="addTaskBtn" onAction="#handleCreateTask" text="Add Task"
                                    styleClass="primary"/>
                            <Button fx:id="cancelTaskBtn" onAction="#handleCancelEditing" text="Cancel"
                                    styleClass="disable"/>
                        </HBox>


                    </VBox>
                </VBox>
                <!-- Stats Card -->
                <VBox styleClass="card-b" maxHeight="200">
                    <Label text="Task Statistics" styleClass="card-b-title"/>
                    <PieChart style="-fx-padding: 10;">
                        <data>
                        </data>
                    </PieChart>
                </VBox>
            </VBox>
        </ScrollPane>

    </right>
    <center>
        <VBox>
            <padding>
                <Insets top="10" left="10" right="10" bottom="10"/>
            </padding>
            <!-- Upcoming Task Card -->
            <HBox styleClass="task-card" spacing="10" alignment="CENTER_LEFT"
                  maxHeight="60" prefHeight="60" maxWidth="500">
                <!-- Task Icon -->
                <Label style="-fx-font-size: 24px;"/>

                <!-- Task Details -->
                <VBox spacing="4">
                    <Label text="Complete Project Proposal"
                           style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="Due: Today 5:00 PM"/>
                </VBox>

                <!-- Progress Indicator -->
                <ProgressBar progress="0.75"
                             style="-fx-accent: #4CAF50; -fx-pref-width: 150;"
                             HBox.hgrow="ALWAYS"/>

                <!-- Status Chip -->
                <Label text="URGENT"
                       style="-fx-background-color: #ffeb3b; -fx-background-radius: 12;
                       -fx-padding: 4 8; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Spacer -->
            <Region minHeight="10"/>

            <!-- Filter Bar -->
            <HBox spacing="15" styleClass="filter-bar">
                <ComboBox promptText="Sort By" styleClass="modern-combo">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Due Date"/>
                            <String fx:value="Priority"/>
                            <String fx:value="Title"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                <CheckBox text="Show Completed"/>
                <CheckBox text="High Priority Only"/>
                <Button text="Apply Filters" styleClass="secondary-button"/>
            </HBox>

            <!-- Spacer -->
            <Region minHeight="10"/>

            <TableView styleClass="modern-table" fx:id="taskTable">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="numberColumn" minWidth="50" prefWidth="50" maxWidth="50.0" text="No"/>
                    <TableColumn fx:id="titleColumn" text="Title"/>
                    <TableColumn fx:id="startDateColumn" text="Start Date"/>
                    <TableColumn fx:id="dueDateColumn" text="Due Date"/>
                    <TableColumn fx:id="progressColumn" text="Progress"/>
                    <TableColumn fx:id="statusColumn" text="Status"/>
                    <TableColumn fx:id="priorityColumn" text="Priority"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
